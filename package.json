{
  "name": "blaeu-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Blaeu — an extensible geospatial kernel. Plugin-first, preset-driven, MapLibre-powered.",
  "keywords": [
    "geospatial",
    "gis",
    "maplibre",
    "map-editor",
    "plugin-architecture",
    "typescript",
    "monorepo",
    "cadastre",
    "urban-planning",
    "geojson"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celikgo/blaeu-lib.git"
  },
  "homepage": "https://github.com/celikgo/blaeu-lib#readme",
  "bugs": {
    "url": "https://github.com/celikgo/blaeu-lib/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "typecheck": "tsc --build --pretty",
    "typecheck:examples": "for d in examples/*/; do tsc -p \"${d}tsconfig.json\" --noEmit || exit 1; done",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:watch": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf packages/*/dist packages/*/.tsbuild packages/*/*.tsbuildinfo tsconfig.tsbuildinfo examples/*/dist",
    "verify": "npm run scaffold:check && npm run lint:boundaries && npm run typecheck && npm run typecheck:examples && npm run typecheck:tests && npm run lint && npm run check:docs && npm run test && npm run build",
    "scaffold": "node scripts/scaffold-packages.mjs",
    "scaffold:check": "node scripts/scaffold-packages.mjs --check",
    "changeset": "changeset",
    "release": "npm run verify && changeset publish",
    "check:docs": "node scripts/check-doc-fences.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "bench": "vitest bench --run",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/geojson": "^7946.0.15",
    "@types/node": "^26.2.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "marked": "^18.0.10",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
