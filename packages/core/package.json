{
  "name": "@blaeu/core",
  "version": "0.1.0",
  "description": "The Blaeu kernel: event bus, plugin registry, pipelines, command bus, feature store.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celikgo/blaeu-lib.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/celikgo/blaeu-lib/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/celikgo/blaeu-lib/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .tsbuild *.tsbuildinfo",
    "prepack": "npm run build"
  },
  "dependencies": {
    "proj4": "^2.12.1",
    "rbush": "^4.0.1"
  },
  "peerDependencies": {
    "maplibre-gl": ">=4.7.0 <7"
  },
  "devDependencies": {
    "maplibre-gl": "^6.4.0",
    "@types/proj4": "^2.5.5",
    "@types/rbush": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
