{
  "name": "@blaeu/preset-game",
  "version": "0.1.1",
  "description": "Game map preset: entity placement, grid snapping, procedural hooks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celikgo/blaeu-lib.git",
    "directory": "packages/preset-game"
  },
  "homepage": "https://github.com/celikgo/blaeu-lib/tree/main/packages/preset-game#readme",
  "bugs": {
    "url": "https://github.com/celikgo/blaeu-lib/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .tsbuild *.tsbuildinfo",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@blaeu/plugin-snap": "^0.1.1",
    "@blaeu/plugin-draw": "^0.1.1",
    "@blaeu/plugin-select": "^0.1.1",
    "@blaeu/plugin-history": "^0.1.1",
    "@blaeu/plugin-ui": "^0.1.1"
  },
  "peerDependencies": {
    "@blaeu/core": "^0.1.1"
  },
  "devDependencies": {
    "@blaeu/core": "^0.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
