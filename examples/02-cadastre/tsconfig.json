{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No `baseUrl` here, and none is needed: `paths` that are declared without one
    // resolve against the directory of the config that *declares* them, which is
    // tsconfig.base.json at the repo root — exactly where the aliases point. `baseUrl`
    // used to be how that was spelled, it is deprecated in TypeScript 6 and removed in
    // 7, and it was already redundant before either. The root tsconfig deliberately
    // does not `reference` the examples — they are apps, not build outputs — so this
    // config still has to stand on its own; it just no longer needs a deprecated
    // option to do it.
    "noEmit": true,
    "composite": false,
    "types": ["vite/client"]
  },
  // The two `jsts-modules.d.ts` files are ambient module declarations that live inside
  // the plugins that need them. Those plugins' own tsconfigs pick them up through
  // `include`; ours resolves the plugins through the `paths` alias (source, not dist),
  // and TypeScript only pulls in files reachable by *import*, never ambient ones. Left
  // out, `new GeoJSONReader()` type-checks against jsts's own (wrong) shipped types and
  // fails in a file this example does not own. Listing them is the whole fix.
  "include": [
    "src",
    "vite.config.ts",
    "../../packages/plugin-edit/src/jsts-modules.d.ts",
    "../../packages/plugin-topology/src/jsts-modules.d.ts"
  ]
}
